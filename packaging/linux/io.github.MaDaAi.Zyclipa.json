{
  "app-id": "io.github.MaDaAi.Zyclipa",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.openjdk25"
  ],
  "command": "zyclipa",
  "finish-args": [
    "--socket=x11",
    "--share=ipc",
    "--share=network",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-download",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/openjdk25/bin"
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "openjdk-runtime",
      "buildsystem": "simple",
      "build-commands": [
        "/usr/lib/sdk/openjdk25/install.sh"
      ]
    },
    {
      "name": "x264",
      "config-opts": [
        "--enable-shared",
        "--enable-pic",
        "--disable-cli"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://code.videolan.org/videolan/x264.git",
          "commit": "b35605ace3ddf7c1a5d67a2eb553f034aef41d55"
        }
      ]
    },
    {
      "name": "ffmpeg",
      "config-opts": [
        "--enable-gpl",
        "--enable-shared",
        "--disable-static",
        "--disable-doc",
        "--disable-debug",
        "--disable-ffplay",
        "--enable-libx264",
        "--enable-libxcb",
        "--enable-libpulse"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/FFmpeg/FFmpeg.git",
          "tag": "n7.1.5",
          "commit": "3a0867c2bfda4a4d4309ca1a8cbdc6175e67f587"
        }
      ]
    },
    {
      "name": "zyclipa",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 zyclipa /app/bin/zyclipa",
        "install -Dm644 zyclipa.jar /app/share/zyclipa/zyclipa.jar",
        "install -Dm644 io.github.MaDaAi.Zyclipa.desktop /app/share/applications/io.github.MaDaAi.Zyclipa.desktop",
        "install -Dm644 io.github.MaDaAi.Zyclipa.metainfo.xml /app/share/metainfo/io.github.MaDaAi.Zyclipa.metainfo.xml",
        "install -Dm644 icon-256.png /app/share/icons/hicolor/256x256/apps/io.github.MaDaAi.Zyclipa.png",
        "install -Dm644 icon-128.png /app/share/icons/hicolor/128x128/apps/io.github.MaDaAi.Zyclipa.png",
        "install -Dm644 LICENSE /app/share/licenses/io.github.MaDaAi.Zyclipa/LICENSE",
        "install -Dm644 THIRD-PARTY-NOTICES.txt /app/share/licenses/io.github.MaDaAi.Zyclipa/THIRD-PARTY-NOTICES.txt"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../build/linux-source"
        }
      ]
    }
  ]
}
